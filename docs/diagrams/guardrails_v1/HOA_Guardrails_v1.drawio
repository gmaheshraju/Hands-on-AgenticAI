        <object label="&lt;b&gt;scanInput() — 9 checks · normalize&lt;/b&gt;&lt;br&gt;1 direct_override w1.00 · 37 regex&lt;br&gt;2 role_hijacking w1.00 · 33 regex&lt;br&gt;3 extraction w0.95 · 36 regex&lt;br&gt;4 encoding w0.95 · 21 regex&lt;br&gt;5 indirect_inject. w1.00 · 29 regex&lt;br&gt;6 context flooding &amp;gt;2000ch, &amp;gt;20 nl → 0.40&lt;br&gt;7 zero-width chars &amp;gt;3 → 0.70&lt;br&gt;8 base64 decode + rescan → 0.85&lt;br&gt;9 hex decode + rescan → 0.85&lt;br&gt;conf = 0.65 + 0.15/extra match, cap 1.0" class="card.primitive" id="card_scan">
          <mxCell style="rounded=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=8;fontColor=#232F3E;html=1;whiteSpace=wrap;align=left;spacingLeft=6;opacity=70;" parent="1" vertex="1">
