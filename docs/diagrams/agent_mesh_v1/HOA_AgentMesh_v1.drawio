          </mxCell>
        </object>
        <object label="&lt;b&gt;ROUTING STRATEGIES — meshRouter.js, code order&lt;/b&gt;&lt;br&gt;selectNode() switch · default least-loaded&lt;br&gt;1 round-robin _roundRobin&lt;br&gt;2 least-loaded _leastLoaded (default)&lt;br&gt;3 capability-based filter → least-loaded&lt;br&gt;4 affinity-sticky _affinitySticky&lt;br&gt;all run on _healthyCandidates&lt;br&gt;excludes FAILED + DEGRADED + excluded" class="card.invariant" id="card_routes">
          <mxCell style="rounded=1;fillColor=#E8EAF6;strokeColor=#3F51B5;fontSize=8;fontColor=#232F3E;html=1;whiteSpace=wrap;align=left;spacingLeft=6;opacity=70;" parent="1" vertex="1">
            <mxGeometry x="336" y="544" width="376" height="184" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;CIRCUIT BREAKER — 3 states, circuitBreaker.js&lt;/b&gt;&lt;br&gt;per-node breaker, lazy registry&lt;br&gt;CLOSED requests flow&lt;br&gt;OPEN blocked&lt;br&gt;HALF_OPEN one probe&lt;br&gt;CLOSED→OPEN ≥ 5 fails&lt;br&gt;OPEN→HALF_OPEN after 10s cooldown&lt;br&gt;HALF_OPEN→CLOSED probe ok&lt;br&gt;HALF_OPEN→OPEN probe fail&lt;br&gt;trip() force-open · reset()" class="card.invariant" id="card_breaker">
          <mxCell style="rounded=1;fillColor=#E8EAF6;strokeColor=#3F51B5;fontSize=8;fontColor=#232F3E;html=1;whiteSpace=wrap;align=left;spacingLeft=6;opacity=70;" parent="1" vertex="1">
            <mxGeometry x="736" y="544" width="376" height="184" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;SELF-HEALING on node_failed — mesh.js&lt;/b&gt;&lt;br&gt;README says HealthMonitor → WorkRedistributor.&lt;br&gt;FALSE: monitor only emits; the MESH owns&lt;br&gt;the bus and drives the reaction:&lt;br&gt;1 router.excludeNode&lt;br&gt;2 breaker.trip()&lt;br&gt;3 collect healthy nodes&lt;br&gt;4 redistribute pending work&lt;br&gt;5 if failed/total ≥ 0.5 → mesh_degraded&lt;br&gt;6 emit node_failed (+redistributed)" class="card.failure" id="card_heal">
          <mxCell style="rounded=1;fillColor=#FFEBEE;strokeColor=#C62828;fontSize=8;fontColor=#232F3E;html=1;whiteSpace=wrap;align=left;spacingLeft=6;opacity=70;" parent="1" vertex="1">
            <mxGeometry x="1136" y="544" width="376" height="184" as="geometry" />
          </mxCell>
        </object>
