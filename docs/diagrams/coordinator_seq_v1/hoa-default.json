{
  "_meta": {
    "theme": "hoa-default",
    "note": "Hands-on-AgenticAI default. Semantic tokens -> hex. Themes remap COLORS ONLY, never layout/spacing/semantics.",
    "derived_from": "FTS fts-default.json, with 2 tokens renamed for domain neutrality (see FACTS.md Portability notes)",
    "renames": {
      "edge.money -> edge.primary": "no money path outside a trading system; the general case is the critical execution path",
      "component.store -> component.artifact": "durable output here is files, not a database"
    },
    "contrast_rule": "text fontColor must keep >=4.5:1 on its fill",
    "l2_note": "state.* and transition.* added 2026-08-25 for L2 (legality) diagrams. state.active replaces the FTS name state.stable: 'money-on' does not generalise, the portable meaning is 'the state where work happens'."
  },
  "boundary": {
    "primary": "#E7157B",
    "external": "#1565C0",
    "datasource": "#9E9E9E",
    "observability": "#E7157B",
    "functional": "#2E7D32"
  },
  "component": {
