<mxfile host="app.diagrams.net">
  <diagram id="hoa_step_lifecycle_v1" name="23 Long-Running Agent — step lifecycle">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="4" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1360" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="z_ex" value="" style="rounded=1;fillColor=none;strokeColor=#E7157B;dashed=1;dashPattern=8 4;strokeWidth=2;html=1;whiteSpace=wrap;fontSize=10;fontColor=#E7157B;" parent="1" vertex="1">
          <mxGeometry x="96" y="112" width="1552" height="680" as="geometry" />
        </mxCell>
        <mxCell id="z_ex_lbl" value="src/executor.js — DurableExecutor.execute() decides every step status" style="text;fontSize=10;fontStyle=1;fontColor=#E7157B;align=left;html=1;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="108" y="120" width="1536" height="16" as="geometry" />
        </mxCell>
        <object label="&lt;b&gt;step i selected&lt;/b&gt;&lt;br&gt;budget is checked here" class="state.initial" id="n_next">
          <mxCell style="rounded=1;fillColor=#E8EAF6;strokeColor=#3F51B5;strokeWidth=1.5;fontSize=9;fontColor=#232F3E;html=1;whiteSpace=wrap;align=center;" parent="1" vertex="1">
            <mxGeometry x="160" y="280" width="208" height="64" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;running&lt;/b&gt;&lt;br&gt;handler in flight" class="state.active" id="s_running">
          <mxCell style="rounded=1;fillColor=#C8E6C9;strokeColor=#2E7D32;strokeWidth=2;fontSize=9;fontColor=#232F3E;html=1;whiteSpace=wrap;align=center;" parent="1" vertex="1">
            <mxGeometry x="496" y="280" width="192" height="64" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;completed&lt;/b&gt;&lt;br&gt;step result recorded" class="state.transitional" id="s_done">
          <mxCell style="rounded=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=1.5;fontSize=9;fontColor=#232F3E;html=1;whiteSpace=wrap;align=center;" parent="1" vertex="1">
            <mxGeometry x="824" y="280" width="208" height="64" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;TASK COMPLETED&lt;/b&gt;&lt;br&gt;terminal — loop exhausted" class="state.terminal" id="t_taskdone">
          <mxCell style="rounded=1;fillColor=#ECEFF1;strokeColor=#455A64;strokeWidth=3;fontSize=9;fontColor=#232F3E;html=1;whiteSpace=wrap;align=center;" parent="1" vertex="1">
            <mxGeometry x="1352" y="280" width="232" height="64" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;failed&lt;/b&gt;&lt;br&gt;recovery decides next" class="state.transitional" id="s_failed">
          <mxCell style="rounded=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=1.5;fontSize=9;fontColor=#232F3E;html=1;whiteSpace=wrap;align=center;" parent="1" vertex="1">
            <mxGeometry x="496" y="488" width="192" height="64" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;skipped&lt;/b&gt;&lt;br&gt;loop continues" class="state.transitional" id="s_skipped">
          <mxCell style="rounded=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=1.5;fontSize=9;fontColor=#232F3E;html=1;whiteSpace=wrap;align=center;" parent="1" vertex="1">
            <mxGeometry x="824" y="488" width="208" height="64" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;TASK ABORTED&lt;/b&gt;&lt;br&gt;terminal — recovery gave up" class="state.terminal" id="t_abort">
          <mxCell style="rounded=1;fillColor=#ECEFF1;strokeColor=#455A64;strokeWidth=3;fontSize=9;fontColor=#232F3E;html=1;whiteSpace=wrap;align=center;" parent="1" vertex="1">
            <mxGeometry x="1352" y="488" width="232" height="64" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;BUDGET EXCEEDED&lt;/b&gt;&lt;br&gt;terminal — stopped at the gate" class="state.terminal" id="t_budget">
          <mxCell style="rounded=1;fillColor=#ECEFF1;strokeColor=#455A64;strokeWidth=3;fontSize=9;fontColor=#232F3E;html=1;whiteSpace=wrap;align=center;" parent="1" vertex="1">
            <mxGeometry x="1352" y="680" width="232" height="64" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;THE RECOVERY CLASSIFIER — COMPLETE, IN CODE ORDER&lt;/b&gt;&lt;br&gt;selectStrategy() computes retriesLeft = (step.retries ?? 0) − retriesUsed, then returns the FIRST branch that matches:&lt;br&gt;1. timeout, retries remain → retry; backoff 100ms × attempt, and the step&#x27;s timeout is doubled&lt;br&gt;2. rate limit, retries remain → retry; exponential backoff, capped at 16s&lt;br&gt;3. auth error → ABORT unconditionally — never retried, never skipped, whatever the step says&lt;br&gt;4. data / validation / parse error → skip if the step is optional, abort if it is critical&lt;br&gt;5. any other error, retries remain → retry; backoff 200ms × attempt&lt;br&gt;6. retries exhausted → skip if optional, abort if critical&lt;br&gt;Branches 1 and 2 FALL THROUGH: each return sits INSIDE its retries-remain test, so once retries are gone the error is&lt;br&gt;re-classified by branches 3-6. An exhausted timeout is decided by branch 6, not branch 1.&lt;br&gt;Branch 1 also matches on error.code, not on the message — the executor&#x27;s own timeout says &#x27;timed out&#x27;, which does not&lt;br&gt;contain the substring &#x27;timeout&#x27; that the first half of that test looks for." class="card.invariant" id="card_classifier">
          <mxCell style="rounded=1;fillColor=#E8EAF6;strokeColor=#3F51B5;strokeWidth=1.5;fontSize=8;fontColor=#232F3E;html=1;whiteSpace=wrap;align=left;spacingLeft=6;opacity=70;" parent="1" vertex="1">
            <mxGeometry x="96" y="824" width="1552" height="208" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;THE CHECKPOINT INDEX IS THE DURABILITY CONTRACT&lt;/b&gt;&lt;br&gt;saveCheckpoint stores currentStepIndex, and a resume reads it back as its&lt;br&gt;starting point. Every call site passes one of exactly two values:&lt;br&gt;i + 1 — the step finished; resume starts AFTER it. Used on completed, on a&lt;br&gt;retry that succeeded, and on both kinds of skip.&lt;br&gt;i — the step did NOT finish; resume RE-RUNS it. Used on the budget stop, on&lt;br&gt;a critical failure, and on an abort.&lt;br&gt;So a step that ran halfway and then aborted executes again from the start. A&lt;br&gt;handler with side effects that is not idempotent applies them twice." class="card.invariant" id="card_checkpoint">
          <mxCell style="rounded=1;fillColor=#E8EAF6;strokeColor=#3F51B5;strokeWidth=1.5;fontSize=8;fontColor=#232F3E;html=1;whiteSpace=wrap;align=left;spacingLeft=6;opacity=70;" parent="1" vertex="1">
            <mxGeometry x="96" y="1064" width="760" height="176" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;TWO STATUSES ARE REPORTED BUT NEVER STORED&lt;/b&gt;&lt;br&gt;On every retry the executor records one status and streams a different one&lt;br&gt;for the SAME event: the timeline gets &#x27;running&#x27;, the onProgress callback&lt;br&gt;gets &#x27;retrying&#x27;. RAN — the stream reads running, retrying, retrying,&lt;br&gt;completed, while the recorded timeline contains no &#x27;retrying&#x27; at all.&lt;br&gt;The budget stop is the mirror image. The event that is both recorded and&lt;br&gt;streamed says &#x27;aborted&#x27;, while the value returned to the caller says&lt;br&gt;&#x27;budget_exceeded&#x27;. RAN — return budget_exceeded, last streamed aborted.&lt;br&gt;So the live stream, the stored timeline and the return value are three&lt;br&gt;vocabularies for the same events. Anything built on one — a dashboard, an&lt;br&gt;alert, a test — disagrees with the other two." class="card.failure" id="card_reported">
          <mxCell style="rounded=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=1.5;fontSize=8;fontColor=#232F3E;html=1;whiteSpace=wrap;align=left;spacingLeft=6;opacity=70;" parent="1" vertex="1">
            <mxGeometry x="888" y="1064" width="760" height="208" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="e_run" value="budget.check() passed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#232F3E;fontColor=#232F3E;fontSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="n_next" target="s_running" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_taskdone" value="no steps left" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#232F3E;fontColor=#232F3E;fontSize=8;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="n_next" target="t_taskdone" edge="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="316" y="168" /><mxPoint x="1468" y="168" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e_budget" value="budget.check() failed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C62828;fontColor=#C62828;fontSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="n_next" target="t_budget" edge="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="264" y="712" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e_done" value="handler resolved" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#232F3E;fontColor=#232F3E;fontSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s_running" target="s_done" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_fail" value="handler threw, or the timeout fired" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C62828;fontColor=#C62828;fontSize=8;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" parent="1" source="s_running" target="s_failed" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_next" value="more steps remain — checkpoint at i+1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E65100;fontColor=#E65100;fontSize=8;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s_done" target="n_next" edge="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="928" y="200" /><mxPoint x="144" y="200" /><mxPoint x="144" y="312" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e_retry" value="classifier: retry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E65100;fontColor=#E65100;fontSize=8;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" parent="1" source="s_failed" target="s_running" edge="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="432" y="520" /><mxPoint x="432" y="416" /><mxPoint x="544" y="416" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e_skip" value="classifier: skip" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C62828;fontColor=#C62828;fontSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s_failed" target="s_skipped" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_abort" value="classifier: abort" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C62828;fontColor=#C62828;fontSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="s_failed" target="t_abort" edge="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="592" y="616" /><mxPoint x="1468" y="616" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e_skipnext" value="more steps remain — checkpoint at i+1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E65100;fontColor=#E65100;fontSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="s_skipped" target="n_next" edge="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="520" /><mxPoint x="1120" y="232" /><mxPoint x="264" y="232" /></Array></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
