          </mxCell>
        </object>
        <object label="&lt;b&gt;Researcher mockTools&lt;/b&gt;&lt;br&gt;web_search(q) — 3 hits&lt;br&gt;fetch_url(u) — canned" class="component.mock" id="n_tool_r">
          <mxCell style="rounded=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;strokeWidth=1.5;fontSize=9;fontColor=#232F3E;html=1;whiteSpace=wrap;align=center;" parent="1" vertex="1">
            <mxGeometry x="1384" y="120" width="248" height="56" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Fact-Checker mockTools&lt;/b&gt;&lt;br&gt;fetch_url(u) only&lt;br&gt;a separate object" class="component.mock" id="n_tool_f">
          <mxCell style="rounded=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;strokeWidth=1.5;fontSize=9;fontColor=#232F3E;html=1;whiteSpace=wrap;align=center;" parent="1" vertex="1">
