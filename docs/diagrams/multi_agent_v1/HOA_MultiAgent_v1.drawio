          </mxCell>
        </object>
        <object label="&lt;b&gt;① Researcher&lt;/b&gt;&lt;br&gt;runResearcher()&lt;br&gt;web_search · fetch_url" class="component.agent" id="n_res">
          <mxCell style="rounded=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=1.5;fontSize=9;fontColor=#232F3E;html=1;whiteSpace=wrap;align=center;" parent="1" vertex="1">
