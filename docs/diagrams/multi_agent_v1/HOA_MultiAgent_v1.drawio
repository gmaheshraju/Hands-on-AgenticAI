          </mxCell>
        </object>
        <object label="&lt;b&gt;④ Fact-Checker&lt;/b&gt;&lt;br&gt;runFactChecker()&lt;br&gt;fetch_url only" class="component.agent" id="n_fc">
          <mxCell style="rounded=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=1.5;fontSize=9;fontColor=#232F3E;html=1;whiteSpace=wrap;align=center;" parent="1" vertex="1">
            <mxGeometry x="1072" y="152" width="176" height="64" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;runPipeline() — supervisor.js · the ONLY module that touches the bus&lt;/b&gt;&lt;br&gt;creates the bus · registers all 5 handlers · awaits each agent fn directly&lt;br&gt;MAX_BUDGET $2 · MAX_RETRIES 2 · assembles the report · resolves the Promise" class="component.service" id="n_super">
          <mxCell style="rounded=1;fillColor=#E8EAF6;strokeColor=#3F51B5;strokeWidth=1.5;fontSize=9;fontColor=#232F3E;html=1;whiteSpace=wrap;align=center;" parent="1" vertex="1">
            <mxGeometry x="424" y="296" width="848" height="64" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;createMessageBus() — messageBus.js&lt;/b&gt;&lt;br&gt;publish(msg) — stamps id + timestamp, appends to log, then invokes every handler for msg.to&lt;br&gt;subscribe(channel, handler) — channel is an agent NAME, not a topic · getLog() · printSummary()" class="component.service" id="n_bus">
          <mxCell style="rounded=1;fillColor=#E8EAF6;strokeColor=#3F51B5;strokeWidth=1.5;fontSize=9;fontColor=#232F3E;html=1;whiteSpace=wrap;align=center;" parent="1" vertex="1">
