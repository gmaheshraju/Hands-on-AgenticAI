        <mxCell id="e_route" value="routes msg.to → handler" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9E9E9E;fontColor=#9E9E9E;fontSize=8;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" parent="1" source="n_bus" target="n_super" edge="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="392" /></Array></mxGeometry>
