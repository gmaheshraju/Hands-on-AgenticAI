        <object label="&lt;b&gt;6 SOURCE TYPES — sources.js, code order&lt;/b&gt;&lt;br&gt;prio 0 SYSTEM_PROMPT — never dropped&lt;br&gt;prio 1 CONVERSATION_HISTORY&lt;br&gt;prio 2 RAG_CHUNKS — RAG tiebreak&lt;br&gt;prio 3 MEMORY&lt;br&gt;prio 4 TOOL_RESULTS&lt;br&gt;prio 5 EXAMPLES&lt;br&gt;within a tier: higher relevanceScore wins&lt;br&gt;assembler ORDER repeats all 6 ranks —&lt;br&gt;a second enumeration that must not drift;&lt;br&gt;unknown type sorts last via ?? 99" class="card.primitive" id="card_types">
          <mxCell style="rounded=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=8;fontColor=#232F3E;html=1;whiteSpace=wrap;align=left;spacingLeft=6;opacity=70;" parent="1" vertex="1">
            <mxGeometry x="336" y="576" width="304" height="160" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;allocate() — budget.js, the whole contract&lt;/b&gt;&lt;br&gt;available = total − floor(total × 0.25)&lt;br&gt;pass 1 · every priority-0 source, always&lt;br&gt;pass 2 · rest in sortByPriority order&lt;br&gt;· remaining &amp;lt;= 0 → drop budget_exhausted&lt;br&gt;· fits → include at full tokens&lt;br&gt;· remaining &amp;gt;= 50 → truncated_to_fit&lt;br&gt;· else → drop insufficient_remaining&lt;br&gt;at most ONE source is ever truncated: pass 2&lt;br&gt;sets remaining = 0 right after it&lt;br&gt;out: included[] truncated[] dropped[]" class="card.invariant" id="card_alloc">
          <mxCell style="rounded=1;fillColor=#E8EAF6;strokeColor=#3F51B5;fontSize=8;fontColor=#232F3E;html=1;whiteSpace=wrap;align=left;spacingLeft=6;opacity=70;" parent="1" vertex="1">
            <mxGeometry x="656" y="576" width="304" height="160" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;4 FAILURE MODES — compactor.js, code order&lt;/b&gt;&lt;br&gt;1 poisoning — same subj, 2 values&lt;br&gt;2 distraction — &amp;lt;10% core vocab&lt;br&gt;3 confusion — &amp;gt;3 vague, &amp;lt;2 nouns&lt;br&gt;4 clash — opposite polarity&lt;br&gt;ACTED ON — only 3 of the 4:&lt;br&gt;· distraction: turn deleted&lt;br&gt;· poisoning + clash: WARNING prepended&lt;br&gt;· confusion: detected, never acted on&lt;br&gt;quality = 1 − (3p+1d+2c+3k) × 0.05&lt;br&gt;all 4 detectors are module-private" class="card.failure" id="card_fail">
