          </mxCell>
        </object>
        <object label="&lt;b&gt;DRIFT — injected in 4 places, detected by 2&lt;/b&gt;&lt;br&gt;INJECTED — simulator.js, one agent only&lt;br&gt; research-agent last 2 of 7 d&lt;br&gt; 1 prompt+completion tokens x1.4&lt;br&gt; 2 latency x1.6&lt;br&gt; 3 tool-call chance .30 -&amp;gt; .55&lt;br&gt; 4 quality score -0.5&lt;br&gt;DETECTED TWICE, BY DIFFERENT MATH&lt;br&gt; A simulator.js — percent change&lt;br&gt; latency &amp;gt;20% · tokens &amp;gt;20%&lt;br&gt; quality drop &amp;gt;0.2 · 3 alerts max&lt;br&gt; writes pct INTO the z_score column&lt;br&gt; runs on every npm start&lt;br&gt; B driftDetector.js — a real z-score&lt;br&gt; |z|&amp;gt;=2 warn · |z|&amp;gt;=3 critical&lt;br&gt; 5 metrics x each agent x model&lt;br&gt; runs only via dashboard.js" class="card.primitive" id="card_drift">
          <mxCell style="rounded=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=1.5;fontSize=8;fontColor=#232F3E;html=1;whiteSpace=wrap;align=left;spacingLeft=6;opacity=70;" parent="1" vertex="1">
            <mxGeometry x="376" y="520" width="296" height="248" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;SIX CLASSES — every construction site&lt;/b&gt;&lt;br&gt;Store store.js&lt;br&gt; simulator.js · dashboard.js&lt;br&gt; 20 data methods, 8 with 0 callers&lt;br&gt;CostTracker costTracker.js&lt;br&gt; simulator.js · dashboard.js&lt;br&gt; 12 public, 2 called&lt;br&gt;QualityScorer qualityScorer.js&lt;br&gt; dashboard.js — then NEVER called&lt;br&gt;DriftDetector driftDetector.js&lt;br&gt; dashboard.js · runAllChecks&lt;br&gt;Tracer tracer.js&lt;br&gt; ZERO construction sites in the repo&lt;br&gt;Span · Trace tracer.js&lt;br&gt; reachable only via Tracer&lt;br&gt;metrics_snapshots store.js is the only&lt;br&gt;table with no writer and no reader" class="card.invariant" id="card_wiring">
          <mxCell style="rounded=1;fillColor=#E8EAF6;strokeColor=#3F51B5;strokeWidth=1.5;fontSize=8;fontColor=#232F3E;html=1;whiteSpace=wrap;align=left;spacingLeft=6;opacity=70;" parent="1" vertex="1">
            <mxGeometry x="688" y="520" width="272" height="248" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;THE PAGE READS FIELDS THE API NEVER SENDS&lt;/b&gt;&lt;br&gt;index.html reads the row carries&lt;br&gt; trace.latencyMs traces has none&lt;br&gt; trace.totalTokens total_tokens&lt;br&gt; trace.costCents total_cost (USD)&lt;br&gt; trace.timestamp started_at&lt;br&gt; span.durationMs latency_ms&lt;br&gt; span.tokens total_tokens&lt;br&gt; span.costCents cost&lt;br&gt; span.toolCalls tool_calls, a string&lt;br&gt; span.children parent_span_id, flat&lt;br&gt; alert.zScore z_score&lt;br&gt; data.metrics dashboard.js&lt;br&gt;Adapted in 2 places only — timeseries,&lt;br&gt;attribution. The rest are read raw.&lt;br&gt;GET /api/traces/:id — dashboard.js filters&lt;br&gt;trace_id; store.js has no such column." class="card.failure" id="card_contract">
          <mxCell style="rounded=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=1.5;fontSize=8;fontColor=#232F3E;html=1;whiteSpace=wrap;align=left;spacingLeft=6;opacity=70;" parent="1" vertex="1">
