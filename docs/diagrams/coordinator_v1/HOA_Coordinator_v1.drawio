        </object>
        <object label="&lt;b&gt;selectAgent() — 7 checks, in order&lt;/b&gt;&lt;br&gt;1 skillIndex.get(skill) → ids, reg order&lt;br&gt;2 map to card, drop deregistered&lt;br&gt;3 sort: lower load first&lt;br&gt;4 tie → lower cost for THAT skill&lt;br&gt;5 no providers → null&lt;br&gt;6 best = providers[0]&lt;br&gt;7 load &amp;gt;= maxConcurrency || 5 → null&lt;br&gt;incrementLoad fires BEFORE the await&lt;br&gt;→ 2nd parallel code task goes to Senior Dev&lt;br&gt;README claims Junior ×2 — observed J then S" class="card.primitive" id="card_route">
          <mxCell style="rounded=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=8;fontColor=#232F3E;html=1;whiteSpace=wrap;align=left;spacingLeft=6;opacity=70;" parent="1" vertex="1">
