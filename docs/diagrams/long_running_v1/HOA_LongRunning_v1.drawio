        <object label="&lt;b&gt;step.handler() — SIMULATED&lt;/b&gt;&lt;br&gt;awaited at executor.js&lt;br&gt;every handler = simulateWork&lt;br&gt;tasks.js — setTimeout, no I/O" class="component.agent" id="n_handler">
          <mxCell style="rounded=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;fontSize=9;fontColor=#232F3E;html=1;whiteSpace=wrap;align=center;" parent="1" vertex="1">
