          </mxCell>
        </object>
        <object label="&lt;b&gt;ExecutionBudget&lt;/b&gt;&lt;br&gt;budget.js · check&lt;br&gt;record · report&lt;br&gt;new per execute()" class="component.service" id="n_budget">
          <mxCell style="rounded=1;fillColor=#E8EAF6;strokeColor=#3F51B5;fontSize=9;fontColor=#232F3E;html=1;whiteSpace=wrap;align=center;" parent="1" vertex="1">
