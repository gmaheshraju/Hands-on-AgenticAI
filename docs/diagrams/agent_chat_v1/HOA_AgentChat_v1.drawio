          </mxCell>
        </object>
        <object label="&lt;b&gt;FIVE SCORES PER RUN · tracer.js end()&lt;/b&gt;&lt;br&gt;1 Tool ROI = used ÷ tool decisions&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;n-gram overlap ≥ 0.15 ⇒ used&lt;br&gt;2 Coherence = consec-thought terms&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;≥ 2 shared terms ⇒ coherent&lt;br&gt;3 Productivity: productive | wasted&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;respond OR result used ⇒ productive&lt;br&gt;4 Confidence signals (from thought)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;hedging·confident·uncertain·&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;seeking_info·ready_to_answer&lt;br&gt;5 Strategy&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;direct·single_tool·multi_tool·iterative&lt;br&gt;→ persisted: agent_runs + decisions" class="card.invariant" id="card_scores">
          <mxCell style="rounded=1;fillColor=#E8EAF6;strokeColor=#3F51B5;fontSize=8;fontColor=#232F3E;html=1;whiteSpace=wrap;align=left;spacingLeft=6;opacity=70;" parent="1" vertex="1">
            <mxGeometry x="344" y="560" width="296" height="224" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;GUARDRAILS — block in, redact both ways&lt;/b&gt;&lt;br&gt;scanInput()&lt;br&gt;&amp;nbsp;&amp;nbsp;16 injection regex → block&lt;br&gt;&amp;nbsp;&amp;nbsp;5 PII types redacted&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;card·ssn·email·phone·apikey&lt;br&gt;&amp;nbsp;&amp;nbsp;blocked ⇒ canned reply&lt;br&gt;scanOutput()&lt;br&gt;&amp;nbsp;&amp;nbsp;same 5 PII masked on answer&lt;br&gt;&amp;nbsp;&amp;nbsp;2 disclaimer patterns flagged&lt;br&gt;one audit_log row per scan" class="card.failure" id="card_guard">
          <mxCell style="rounded=1;fillColor=#FFEBEE;strokeColor=#C62828;fontSize=8;fontColor=#232F3E;html=1;whiteSpace=wrap;align=left;spacingLeft=6;opacity=70;" parent="1" vertex="1">
            <mxGeometry x="664" y="560" width="296" height="160" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;PRODUCTION LIMITS — safe to expose publicly&lt;/b&gt;&lt;br&gt;rate/IP: 300 read · 20 write per min&lt;br&gt;20 concurrent runs → 503&lt;br&gt;message &amp;gt; 8000 chars → 413&lt;br&gt;JSON body ≤ 64 kb&lt;br&gt;CSP + 5 security headers&lt;br&gt;graceful drain + WAL checkpoint" class="card.primitive" id="card_limits">
