          </mxCell>
        </object>
        <object label="&lt;b&gt;SCENARIO ROUTER — 8 entries, first match wins · agent.js&lt;/b&gt;&lt;br&gt;1 refund_policy /refund|return|money back/i&lt;br&gt;2 send_email · 3 database_query — the two HITL flows&lt;br&gt;4 rate_limit · 5 context_long · 6 timeout&lt;br&gt;7 network_error · 8 default /.*/&lt;br&gt;loop skips &#x27;default&#x27;, returns it as fallback" class="card.primitive" id="card_router">
          <mxCell style="rounded=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=1.5;fontSize=8;fontColor=#232F3E;html=1;whiteSpace=wrap;align=left;spacingLeft=6;opacity=70;" parent="1" vertex="1">
            <mxGeometry x="832" y="520" width="424" height="92" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;TYPED ERROR BRANCHES — the complete switch · chat.js&lt;/b&gt;&lt;br&gt;1 rate_limit — live countdown; the server itself auto-retries after retry_after s (server.js)&lt;br&gt;2 context_too_long — Summarize and Continue / Start New Chat&lt;br&gt;3 timeout — Try Again / Dismiss, prints elapsed seconds&lt;br&gt;4 network_error — Retry Now; header status flips to Disconnected&lt;br&gt;5 default — Something Went Wrong / Try Again. Only branch 1 leaves the stream alive." class="card.failure" id="card_errors">
          <mxCell style="rounded=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=1.5;fontSize=8;fontColor=#232F3E;html=1;whiteSpace=wrap;align=left;spacingLeft=6;opacity=70;" parent="1" vertex="1">
