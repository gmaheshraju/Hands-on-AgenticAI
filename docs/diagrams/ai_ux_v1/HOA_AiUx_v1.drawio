        <object label="&lt;b&gt;SSE EVENT TYPES — all 8, in first-emission order · server.js&lt;/b&gt;&lt;br&gt;1 stream_start · 2 stream_stop&lt;br&gt;3 thinking · 4 token (text + confidence)&lt;br&gt;5 citation · 6 hitl_request&lt;br&gt;7 done · 8 error&lt;br&gt;client also listens &#x27;error_event&#x27; — no server emitter" class="card.invariant" id="card_events">
          <mxCell style="rounded=1;fillColor=#E8EAF6;strokeColor=#3F51B5;strokeWidth=1.5;fontSize=8;fontColor=#232F3E;html=1;whiteSpace=wrap;align=left;spacingLeft=6;opacity=70;" parent="1" vertex="1">
